# 复制本文件为 .env.local 并填写本机的 PathOfBuilding-PoE2 路径
# 建议将大体积只读引擎留在 OneDrive 或本机独立目录，不提交进 Git

POB2_ROOT=/path/to/PathOfBuilding-PoE2
POE2_HOST=127.0.0.1
POE2_PORT=8788
# auto = 按本机 CPU 核数与物理内存自动推荐（8G→2, 12G→3, 16G→4, 24G→5, 32G+→6），也可手填数字覆盖
POE2_WORKERS=auto
POE2_WORKERS_MIN=1
# auto = 大批量消融算完后自动停掉突发扩容进程释放内存（低内存 30s / 常规 60s）
POE2_BURST_IDLE_SEC=auto
POE2_IDLE_MIN=30
POE2_ALLOWED_ORIGINS=chrome-extension://*
